supportpowers-support-powers-palette =
    .ready = ГОТОВО
    .hold = НА ПАУЗЕ

button-command-bar-attack-move =
    .tooltip = Движение с атакой
    .tooltipdesc =
    Выбранные юниты пойдут в указанную точку
    и атакуют встреченных врагов по пути.

    Удерживайте <(Ctrl)> при выборе цели, чтобы приказать штурм:
    атаковать любые юниты и здания по пути.

    ЛКМ по иконке, затем ПКМ по точке назначения.

button-command-bar-guard =
    .tooltip = Охранять
    .tooltipdesc =
    Выбранные юниты будут следовать за целью.

    ЛКМ по иконке, затем ПКМ по нужному юниту.

button-command-bar-scatter =
    .tooltip = Рассредоточиться
    .tooltipdesc =
    Выбранные юниты прекратят текущие действия
    и отойдут в ближайшую точку.

    Срабатывает сразу для выбранных юнитов.

button-command-bar-stop =
    .tooltip = Стоп
    .tooltipdesc =
    Выбранные юниты прекратят текущие действия.
    Выбранные здания сбросят точку сбора.

    Срабатывает сразу для выбранных целей.

button-command-bar-queue-orders =
    .tooltip = Режим маршрута
    .tooltipdesc =
    Режим маршрута даёт выбранным юнитам цепочку команд.
    Юниты выполнят команды сразу после получения.

    ЛКМ по иконке, затем отдайте команды на карте.
    Удерживайте <(Shift)> для временного включения.

button-stance-bar-attackanything =
    .tooltip = Режим «Атаковать всё»
    .tooltipdesc =
    Приказ выбранным юнитам атаковать всё:
     - Юниты атакуют врагов и здания в зоне видимости
     - Юниты преследуют атакующих по полю боя

button-stance-bar-defend =
    .tooltip = Режим обороны
    .tooltipdesc =
    Приказ выбранным юнитам обороняться:
     - Юниты атакуют врагов в зоне видимости
     - Юниты не двигаются и не преследуют врагов

button-stance-bar-returnfire =
    .tooltip = Ответный огонь
    .tooltipdesc =
    Приказ выбранным юнитам отвечать огнём:
     - Юниты отвечают врагам, которые атаковали их
     - Юниты не двигаются и не преследуют врагов

button-stance-bar-holdfire =
    .tooltip = Не стрелять
    .tooltipdesc =
    Приказ выбранным юнитам держать огонь:
     - Юниты не открывают огонь по врагам
     - Юниты не двигаются и не преследуют врагов

